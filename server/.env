# ---- Copy to .env and fill in. Placeholders only; never commit real secrets. ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
# REQUIRED, >=16 chars. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# ---- LLM provider: mock | openai | anthropic ----
# "mock" is deterministic and clearly labelled MOCK in the UI. No model is called.
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional cost estimation (USD per 1K tokens)
COST_PER_1K_INPUT_USD=0
COST_PER_1K_OUTPUT_USD=0

# ---- Limits & policies ----
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
MAX_PARALLEL_STEPS=3
MAX_RETRY_CHAIN=3
MAX_CONCURRENT_EXECUTIONS_PER_USER=3
APPROVAL_TIMEOUT_MS=600000
# Hosts the http_fetch tool may contact (comma-separated). Empty = all external fetches denied.
FETCH_ALLOWED_HOSTS=
